# 后端运行配置：复制为 .env 后按需修改；环境变量优先级高于 .env 文件。
# 不设置时使用 app/config.py 里的默认值，原有启动命令行为不变。

# 运行环境标识（local / test / prod …），会打印在启动日志里
APP_ENV=local
# 监听地址与端口；容器里由 Dockerfile 固定 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
# 允许的跨域来源，多个用英文逗号分隔
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 列表分页：默认每页条数、每页上限（上限不能小于默认值）
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
# 应用名称（可选）
APP_NAME=冷链物流温控运营平台
