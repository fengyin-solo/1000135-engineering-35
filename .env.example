# 运行配置示例：本地开发与 docker compose 部署共用同一份来源。
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不入库。
#   cp .env.example .env
# 所有变量都不设置时，沿用代码内置默认值（即下面写出的值），原有启动命令行为不变。

# 运行环境标识，如 local / staging / prod；启动日志会打印，用于区分本地与容器
APP_ENV=local
# 监听地址与端口；本地默认 127.0.0.1，容器内由 Dockerfile 固定为 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许的跨域来源，多个用英文逗号分隔；前端 dev server 默认从 5173 端口访问
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 列表接口分页：默认每页条数、每页条数上限（接口对超过上限的请求返回 400）
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
